{
  "name": "flow",
  "productName": "Flow",
  "version": "0.1.0",
  "description": "Push-to-talk dictation for Windows. Hold a key, speak, release — text lands at the cursor.",
  "license": "MIT",
  "author": "Flow contributors",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "pnpm typecheck && electron-vite build",
    "sign-catalog": "node scripts/sign-catalog.mjs",
    "icons": "electron scripts/make-icons.mjs",
    "dist": "pnpm build && electron-builder --win --publish never",
    "release": "pnpm build && electron-builder --win --publish always"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2",
    "onnxruntime-node": "^1.30.0",
    "smol-toml": "^1.9.0",
    "transcribe-cpp": "0.3.0",
    "uiohook-napi": "^1.5.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/recursive": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "lucide-react": "^1.51.0",
    "prettier": "^3.9.9",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
